rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAnonymousUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isSuperAdmin() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'yui1218.cc@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email.lower() == 'yui1218.cc@gmail.com'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function canWriteLeaderboard(data) {
      return isVerifiedUser()
        || (isAnonymousUser() && data.displayName == '唔知邊個(unknown)');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPhotoDataUrl(val) {
      return val is string
        && val.size() <= 250000
        && (
          val.size() == 0
          || (
            val.size() >= 30
            && (
              val[0:22] == 'data:image/jpeg;base64'
              || val[0:21] == 'data:image/png;base64'
              || val[0:22] == 'data:image/webp;base64'
            )
          )
        );
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // 3. Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'favoriteMbti', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('favoriteMbti' in data) || (data.favoriteMbti is string && data.favoriteMbti.size() == 4 && data.favoriteMbti.matches('^[EI][SN][TF][JP]$')))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserScore(data, userId) {
      return data.keys().hasAll(['userId', 'gameMode', 'themeId', 'themeName', 'difficultyId', 'highScore', 'bestTimeSec', 'stars', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'gameMode', 'themeId', 'themeName', 'difficultyId', 'highScore', 'bestTimeSec', 'maxCombo', 'stars', 'createdAt', 'updatedAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.gameMode in ['flip', 'link']
        && data.themeId is string
        && data.themeId.size() >= 1
        && data.themeId.size() <= 64
        && data.themeId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.themeName is string
        && data.themeName.size() >= 1
        && data.themeName.size() <= 60
        && data.difficultyId is string
        && data.difficultyId.size() >= 1
        && data.difficultyId.size() <= 32
        && data.difficultyId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.highScore is number
        && data.highScore >= 0
        && data.highScore <= 1000000
        && data.bestTimeSec is number
        && data.bestTimeSec >= 0
        && data.bestTimeSec <= 86400
        && (!('maxCombo' in data) || (data.maxCombo is number && data.maxCombo >= 1 && data.maxCombo <= 500))
        && data.stars is int
        && data.stars >= 1
        && data.stars <= 3
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomTheme(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'icon', 'items', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'name', 'icon', 'items', 'createdAt', 'updatedAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.icon is string
        && data.icon.size() >= 1
        && data.icon.size() <= 12
        && data.items is list
        && data.items.size() >= 6
        && data.items.size() <= 24
        && data.items[0] is map
        && data.items[0].keys().hasAll(['id', 'name', 'symbol', 'color'])
        && data.items[0].keys().hasOnly(['id', 'name', 'symbol', 'color', 'spiritRefId'])
        && data.items[0].id is string
        && data.items[0].id.size() >= 1
        && data.items[0].id.size() <= 64
        && data.items[0].name is string
        && data.items[0].name.size() >= 1
        && data.items[0].name.size() <= 40
        && data.items[0].symbol is string
        && data.items[0].symbol.size() >= 1
        && data.items[0].symbol.size() <= 16
        && data.items[0].color is string
        && data.items[0].color.size() >= 1
        && data.items[0].color.size() <= 40
        && (!('spiritRefId' in data.items[0]) || (data.items[0].spiritRefId is string && data.items[0].spiritRefId.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompatibilityLog(data, userId) {
      return data.keys().hasAll(['userId', 'personAName', 'personAZodiac', 'personAMbti', 'personBName', 'personBZodiac', 'personBMbti', 'relationType', 'overallScore', 'verdict', 'createdAt'])
        && data.keys().hasOnly(['userId', 'personAName', 'personAZodiac', 'personAMbti', 'personBName', 'personBZodiac', 'personBMbti', 'relationType', 'overallScore', 'verdict', 'createdAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.personAName is string
        && data.personAName.size() >= 1
        && data.personAName.size() <= 40
        && data.personAZodiac is string
        && data.personAZodiac.size() >= 1
        && data.personAZodiac.size() <= 16
        && data.personAMbti is string
        && data.personAMbti.size() == 4
        && data.personAMbti.matches('^[EI][SN][TF][JP]$')
        && data.personBName is string
        && data.personBName.size() >= 1
        && data.personBName.size() <= 40
        && data.personBZodiac is string
        && data.personBZodiac.size() >= 1
        && data.personBZodiac.size() <= 16
        && data.personBMbti is string
        && data.personBMbti.size() == 4
        && data.personBMbti.matches('^[EI][SN][TF][JP]$')
        && data.relationType in ['love', 'friend', 'work', 'creative']
        && data.overallScore is number
        && data.overallScore >= 0
        && data.overallScore <= 100
        && data.verdict is string
        && data.verdict.size() >= 1
        && data.verdict.size() <= 60
        && data.createdAt is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'displayName', 'gameMode', 'themeId', 'themeName', 'difficultyId', 'highScore', 'bestTimeSec', 'stars', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'gameMode', 'themeId', 'themeName', 'difficultyId', 'highScore', 'bestTimeSec', 'stars', 'isPublic', 'createdAt', 'updatedAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.gameMode in ['flip', 'link']
        && data.themeId is string
        && data.themeId.size() >= 1
        && data.themeId.size() <= 64
        && data.themeId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.themeName is string
        && data.themeName.size() >= 1
        && data.themeName.size() <= 60
        && data.difficultyId is string
        && data.difficultyId.size() >= 1
        && data.difficultyId.size() <= 32
        && data.difficultyId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.highScore is number
        && data.highScore >= 0
        && data.highScore <= 1000000
        && data.bestTimeSec is number
        && data.bestTimeSec >= 0
        && data.bestTimeSec <= 86400
        && data.stars is int
        && data.stars >= 1
        && data.stars <= 3
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyNotice(data, noticeId) {
      return noticeId in ['birthday', 'confession']
        && data.keys().hasAll(['type', 'activeDate', 'recipientName', 'senderName', 'message', 'isActive', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['type', 'activeDate', 'recipientName', 'senderName', 'message', 'photoDataUrl', 'isActive', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.type == noticeId
        && data.activeDate is string
        && data.activeDate.size() == 10
        && data.activeDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.recipientName is string
        && data.recipientName.size() >= 1
        && data.recipientName.size() <= 40
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 40
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 10000
        && (!('photoDataUrl' in data) || isValidPhotoDataUrl(data.photoDataUrl))
        && data.isActive is bool
        && data.updatedBy is string
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNoticeRequest(data) {
      return data.keys().hasAll(['requesterUid', 'type', 'targetDate', 'recipientName', 'senderName', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['requesterUid', 'type', 'targetDate', 'recipientName', 'senderName', 'message', 'photoDataUrl', 'contactNote', 'status', 'createdAt', 'reviewedAt'])
        && data.requesterUid is string
        && isValidId(data.requesterUid)
        && data.type in ['birthday', 'confession']
        && data.targetDate is string
        && data.targetDate.size() == 10
        && data.targetDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.recipientName is string
        && data.recipientName.size() >= 1
        && data.recipientName.size() <= 40
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 40
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 10000
        && (!('photoDataUrl' in data) || isValidPhotoDataUrl(data.photoDataUrl))
        && (!('contactNote' in data) || (data.contactNote is string && data.contactNote.size() <= 80))
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is timestamp
        && (!('reviewedAt' in data) || data.reviewedAt is timestamp);
    }

    function isValidReservedSlot(data, slotId) {
      return data.keys().hasAll(['slotId', 'type', 'targetDate', 'isBooked', 'createdAt'])
        && data.keys().hasOnly(['slotId', 'type', 'targetDate', 'isBooked', 'createdAt'])
        && data.slotId is string
        && data.slotId.size() >= 12
        && data.slotId.size() <= 32
        && data.slotId == slotId
        && data.type in ['birthday', 'confession']
        && data.targetDate is string
        && data.targetDate.size() == 10
        && data.targetDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && slotId == (data.type + '_' + data.targetDate)
        && data.isBooked is bool
        && data.createdAt is timestamp;
    }

    function isValidScheduledNotice(data, slotId) {
      return data.keys().hasAll(['type', 'targetDate', 'recipientName', 'senderName', 'message', 'isActive', 'activateAt', 'expireAt', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['type', 'targetDate', 'recipientName', 'senderName', 'message', 'photoDataUrl', 'isActive', 'activateAt', 'expireAt', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.type in ['birthday', 'confession']
        && data.targetDate is string
        && data.targetDate.size() == 10
        && data.targetDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && slotId == (data.type + '_' + data.targetDate)
        && data.recipientName is string
        && data.recipientName.size() >= 1
        && data.recipientName.size() <= 40
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 40
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 10000
        && (!('photoDataUrl' in data) || isValidPhotoDataUrl(data.photoDataUrl))
        && data.isActive is bool
        && data.activateAt is timestamp
        && data.expireAt is timestamp
        && data.expireAt > data.activateAt
        && data.updatedBy is string
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data, adminUid) {
      return data.keys().hasAll(['uid', 'note', 'createdAt'])
        && data.keys().hasOnly(['uid', 'note', 'createdAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == adminUid
        && data.note is string
        && data.note.size() >= 1
        && data.note.size() <= 60
        && data.createdAt is timestamp;
    }

    // 4. Collection Match Blocks
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'favoriteMbti', 'updatedAt'])
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      match /scores/{scoreId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(scoreId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(scoreId)
          && isValidUserScore(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(scoreId)
          && isValidUserScore(incoming(), userId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['themeName', 'highScore', 'bestTimeSec', 'maxCombo', 'stars', 'updatedAt'])
          && incoming().userId == existing().userId
          && incoming().gameMode == existing().gameMode
          && incoming().themeId == existing().themeId
          && incoming().difficultyId == existing().difficultyId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(scoreId);
      }

      match /customThemes/{themeId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(themeId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(themeId)
          && isValidCustomTheme(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(themeId)
          && isValidCustomTheme(incoming(), userId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'icon', 'items', 'updatedAt'])
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(themeId);
      }

      match /compatibilityLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(logId)
          && isValidCompatibilityLog(incoming(), userId)
          && incoming().createdAt == request.time
          && parentUserExists(userId);
        allow update: if false;
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(logId);
      }
    }

    match /leaderboard/{entryId} {
      allow get: if isValidId(entryId)
        && (
          resource == null
          || (resource.data.isPublic == true && resource.data.highScore >= 0)
          || (isSignedIn() && resource.data.userId == request.auth.uid)
        );
      allow list: if resource.data.isPublic == true;
      allow create: if canWriteLeaderboard(incoming())
        && isValidId(entryId)
        && isValidLeaderboardEntry(incoming())
        && entryId == (request.auth.uid + '_' + incoming().gameMode + '_' + incoming().difficultyId + '_' + incoming().themeId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if canWriteLeaderboard(incoming())
        && isValidId(entryId)
        && isValidLeaderboardEntry(incoming())
        && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'themeName', 'highScore', 'bestTimeSec', 'stars', 'isPublic', 'updatedAt'])
        && incoming().userId == existing().userId
        && incoming().gameMode == existing().gameMode
        && incoming().themeId == existing().themeId
        && incoming().difficultyId == existing().difficultyId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isVerifiedUser()
        && isValidId(entryId)
        && existing().userId == request.auth.uid;
    }

    match /dailyNotices/{noticeId} {
      allow get: if isValidId(noticeId) && (isAdmin() || resource == null || resource.data.isActive == true);
      allow list: if resource.data.isActive == true;
      allow create: if isAdmin()
        && isValidId(noticeId)
        && isValidDailyNotice(incoming(), noticeId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(noticeId)
        && isValidDailyNotice(incoming(), noticeId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['activeDate', 'recipientName', 'senderName', 'message', 'photoDataUrl', 'isActive', 'updatedBy', 'updatedAt'])
        && incoming().type == existing().type
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(noticeId);
    }

    match /noticeRequests/{requestId} {
      allow get: if isValidId(requestId)
        && (isAdmin() || (isSignedIn() && resource != null && resource.data.requesterUid == request.auth.uid));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.requesterUid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(requestId)
        && isValidNoticeRequest(incoming())
        && incoming().requesterUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && !('reviewedAt' in incoming());
      allow update: if isAdmin()
        && isValidId(requestId)
        && isValidNoticeRequest(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && incoming().requesterUid == existing().requesterUid
        && incoming().type == existing().type
        && incoming().targetDate == existing().targetDate
        && incoming().createdAt == existing().createdAt
        && incoming().reviewedAt == request.time;
      allow delete: if isValidId(requestId)
        && (isAdmin() || (isSignedIn() && resource != null && resource.data.requesterUid == request.auth.uid));
    }

    match /reservedSlots/{slotId} {
      allow get: if isValidId(slotId)
        && (resource == null || resource.data.isBooked == true || isAdmin());
      allow list: if resource.data.isBooked == true;
      allow create: if isAdmin()
        && isValidId(slotId)
        && isValidReservedSlot(incoming(), slotId)
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(slotId)
        && isValidReservedSlot(incoming(), slotId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['isBooked'])
        && incoming().slotId == existing().slotId
        && incoming().type == existing().type
        && incoming().targetDate == existing().targetDate
        && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(slotId);
    }

    match /scheduledNotices/{slotId} {
      allow get: if isValidId(slotId)
        && (
          isAdmin()
          || resource == null
          || (
            resource.data.isActive == true
            && resource.data.activateAt <= request.time
            && resource.data.expireAt > request.time
          )
        );
      allow list: if isSuperAdmin() && resource.data.targetDate > '';
      allow create: if isAdmin()
        && isValidId(slotId)
        && isValidScheduledNotice(incoming(), slotId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(slotId)
        && isValidScheduledNotice(incoming(), slotId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['recipientName', 'senderName', 'message', 'photoDataUrl', 'isActive', 'activateAt', 'expireAt', 'updatedBy', 'updatedAt'])
        && incoming().type == existing().type
        && incoming().targetDate == existing().targetDate
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(slotId);
    }

    match /admins/{adminUid} {
      allow get: if isOwner(adminUid) && isValidId(adminUid);
      allow list: if isSuperAdmin() && resource.data.uid > '';
      allow create: if isSuperAdmin()
        && isValidId(adminUid)
        && isValidAdminUser(incoming(), adminUid)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSuperAdmin() && isValidId(adminUid);
    }
  }
}
